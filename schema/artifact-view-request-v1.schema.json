{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panopticon.local/schema/artifact-view-request-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "manifest_sha256", "operation"],
  "properties": {
    "schema_version": {"const": "1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation": {"enum": ["view", "download"]}
  }
}
