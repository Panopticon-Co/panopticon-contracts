                "const": "COLLECT_NETWORK_CONNECTIONS"
              },
              "asset_class": {
                "const": "unknown"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "entries": {
          "contains": {
            "properties": {
              "action": {
                "const": "COLLECT_FILE"
              },
              "asset_class": {
                "const": "standard"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    },
    {
