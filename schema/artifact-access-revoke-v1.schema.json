{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panopticon.local/schema/artifact-access-revoke-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "request_id", "reason"],
  "properties": {
    "schema_version": {"const": "1"},
    "policy_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"}
  }
}
