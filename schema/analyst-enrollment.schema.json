{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panopticon.local/schema/analyst-enrollment.json",
  "title": "Bootstrap-authorized analyst enrollment",
  "type": "object",
  "additionalProperties": false,
  "required": ["analyst_id"],
  "properties": {
    "analyst_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "role": {"enum": ["viewer", "responder", "approver", "analyst", "artifact_admin"], "default": "analyst"}
  }
}
