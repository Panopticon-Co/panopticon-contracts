{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panopticon.example/schema/endpoint-record/1.0/families/remote_thread.schema.json",
  "title": "Remote thread creation observation (Sysmon EID 8)",
  "description": "kind=observation, category=remote_thread, type=create. The actor created a thread in target. start_module/start_function are Sysmon's own inference (reported_inference), not symbol verification.",
  "type": "object",
  "properties": {
    "format": {
      "const": "windows_sysmon_extended_v1"
    },
    "event": {
      "type": "object",
      "properties": {
        "category": {
          "const": "remote_thread"
        },
        "type": {
          "const": "create"
        },
        "timestamp": {
          "$ref": "https://panopticon.example/schema/endpoint-record/1.0/families/common.schema.json#/$defs/utc_ms"
        }
      },
      "required": [
        "category",
        "type",
        "timestamp"
      ],
      "additionalProperties": false
    },
    "process": {
      "$ref": "https://panopticon.example/schema/endpoint-record/1.0/families/common.schema.json#/$defs/ext_process"
    },
    "source_facts": {
      "type": "object",
      "properties": {
        "representation": {
          "const": "decoded_source_facts_v1"
        },
        "source": {
          "$ref": "https://panopticon.example/schema/endpoint-record/1.0/families/common.schema.json#/$defs/facts_source"
        },
        "family": {
          "const": "remote_thread"
        },
        "event_time_ns": {
          "$ref": "https://panopticon.example/schema/endpoint-record/1.0/families/common.schema.json#/$defs/decimal_i64"
        },
        "process": {
          "$ref": "https://panopticon.example/schema/endpoint-record/1.0/families/common.schema.json#/$defs/facts_context"
        },
        "event_id": {
          "const": 8
        },
        "event_time_field": {
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "https://panopticon.example/schema/endpoint-record/1.0/families/common.schema.json#/$defs/facts_context"
            },
            {
              "type": "null"
            }
          ]
        },
        "windows_event_data": {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://panopticon.example/schema/endpoint-record/1.0/families/common.schema.json#/$defs/text"
          },
          "description": "Every Sysmon EventData field by its source name, exact text."
        }
      },
      "required": [
        "representation",
        "source",
        "family",
        "event_time_ns",
        "process",
        "event_id",
        "event_time_field",
        "target",
        "windows_event_data"
      ],
      "additionalProperties": false
    },
    "enrichment": {
      "$ref": "https://panopticon.example/schema/endpoint-record/1.0/families/common.schema.json#/$defs/enrichment"
    },
    "attribution": {
      "$ref": "https://panopticon.example/schema/endpoint-record/1.0/families/common.schema.json#/$defs/attribution"
    },
    "unavailable": {
      "$ref": "https://panopticon.example/schema/endpoint-record/1.0/families/common.schema.json#/$defs/unavailable"
    },
    "remote_thread": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "https://panopticon.example/schema/endpoint-record/1.0/families/common.schema.json#/$defs/ext_process"
        },
        "new_thread_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "start_address": {
          "$ref": "https://panopticon.example/schema/endpoint-record/1.0/families/common.schema.json#/$defs/nullable_u64"
        },
        "start_module": {
          "$ref": "https://panopticon.example/schema/endpoint-record/1.0/families/common.schema.json#/$defs/nullable_text"
        },
        "start_function": {
          "$ref": "https://panopticon.example/schema/endpoint-record/1.0/families/common.schema.json#/$defs/nullable_text"
        },
        "start_module_function_confidence": {
          "const": "reported_inference"
        }
      },
      "required": [
        "target",
        "new_thread_id",
        "start_address",
        "start_module",
        "start_function",
        "start_module_function_confidence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "event",
    "process",
    "source_facts",
    "enrichment",
    "attribution",
    "unavailable",
    "remote_thread"
  ],
  "additionalProperties": false
}
