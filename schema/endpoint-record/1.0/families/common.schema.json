{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panopticon.example/schema/endpoint-record/1.0/families/common.schema.json",
  "title": "Endpoint record 1.0 family building blocks",
  "$defs": {
    "decimal_u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Unsigned 64-bit value as a decimal string (no JSON number rounding)."
    },
    "decimal_i64": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,18})$",
      "description": "Signed 64-bit decimal string; event_time_ns is nanoseconds since 1970-01-01T00:00:00Z."
    },
    "nullable_u64": {
      "anyOf": [
        {
          "$ref": "#/$defs/decimal_u64"
        },
        {
          "type": "null"
        }
      ]
    },
    "hex_text": {
      "type": "object",
      "properties": {
        "encoding": {
          "const": "hex"
        },
        "bytes": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})*$"
        },
        "byte_length": {
          "$ref": "#/$defs/decimal_u64"
        }
      },
      "required": [
        "encoding",
        "bytes",
        "byte_length"
      ],
      "additionalProperties": false,
      "description": "Source bytes that were not valid UTF-8, kept losslessly as lowercase hex."
    },
    "text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/hex_text"
        }
      ],
      "description": "Exact decoded source text, or hex_text when not valid UTF-8."
    },
    "nullable_text": {
      "anyOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "null"
        }
      ],
      "description": "null means the source did not supply the field."
    },
    "utc_ms": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "sha256_or_null": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "process_reference": {
      "$ref": "https://panopticon.example/schema/endpoint-record/1.0#/$defs/ProcessReference"
    },
    "source_kind": {
      "enum": [
        "etw",
        "sysmon",
        "windows_event_log",
        "minifilter",
        "api_hook",
        "etw_kernel"
      ]
    },
    "source_kind_value": {
      "enum": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "description": "C++ TelemetrySourceKind index: 0 etw, 1 sysmon, 2 windows_event_log, 3 minifilter, 4 api_hook. Informational; use the name.; 5 etw_kernel."
    },
    "phase": {
      "enum": [
        "reported",
        "attempted",
        "completed"
      ],
      "description": "reported: the source states the operation happened without a pre/post split (Sysmon). attempted: observed before the operation ran; outcome unknown. completed: observed after completion; status carries the native result."
    },
    "native_status": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "ntstatus",
                "win32_error"
              ]
            },
            "value": {
              "$ref": "#/$defs/decimal_u64"
            },
            "hex": {
              "type": "string",
              "pattern": "^0x[0-9A-F]{8}$"
            },
            "interpreted": {
              "const": false
            }
          },
          "required": [
            "kind",
            "value",
            "hex",
            "interpreted"
          ],
          "additionalProperties": false,
          "description": "Native completion code exactly as reported; not converted into a success verdict."
        },
        {
          "type": "null"
        }
      ]
    },
    "facts_source": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/source_kind"
        },
        "kind_value": {
          "$ref": "#/$defs/source_kind_value"
        },
        "provider": {
          "$ref": "#/$defs/text"
        },
        "channel": {
          "$ref": "#/$defs/nullable_text"
        },
        "record_id": {
          "$ref": "#/$defs/nullable_u64"
        }
      },
      "required": [
        "kind",
        "kind_value",
        "provider",
        "channel",
        "record_id"
      ],
      "additionalProperties": false
    },
    "facts_context": {
      "type": "object",
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "start_time_ticks": {
          "$ref": "#/$defs/nullable_u64"
        },
        "executable": {
          "$ref": "#/$defs/nullable_text"
        },
        "process_name": {
          "$ref": "#/$defs/nullable_text"
        },
        "user_name": {
          "$ref": "#/$defs/nullable_text"
        },
        "user_sid": {
          "$ref": "#/$defs/nullable_text"
        },
        "process_guid": {
          "$ref": "#/$defs/nullable_text"
        }
      },
      "required": [
        "pid",
        "executable",
        "process_name",
        "user_name",
        "user_sid",
        "process_guid"
      ],
      "additionalProperties": false,
      "description": "Acting (or target) process exactly as the source decoded it. start_time_ticks is FILETIME creation ticks only when the source supplied them for this instance; absent in records from producers before revision 1 introduced it (treat as unknown)."
    },
    "enrichment": {
      "type": "object",
      "properties": {
        "cached_process_context": {
          "type": "object"
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "Separate, non-authoritative cache hints. Never replaces source_facts."
    },
    "legacy_event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^evt_[0-9a-f]{64}$"
        },
        "category": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "timestamp": {
          "$ref": "#/$defs/utc_ms"
        }
      },
      "required": [
        "id",
        "category",
        "type",
        "timestamp"
      ],
      "additionalProperties": false
    },
    "legacy_source": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/source_kind"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "provider",
        "channel",
        "record_id"
      ],
      "additionalProperties": false,
      "description": "Legacy alias. record_id is a JSON number that some consumers round above 2^53; provenance.native_record_id is authoritative."
    },
    "agent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "os": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "build": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "build"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "hostname",
        "os"
      ],
      "additionalProperties": false
    },
    "user": {
      "type": "object",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "domain",
        "sid"
      ],
      "additionalProperties": false
    },
    "legacy_parent": {
      "type": "object",
      "properties": {
        "entity_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^proc_[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "pid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/process_reference"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "entity_id",
        "pid",
        "name"
      ],
      "additionalProperties": false
    },
    "legacy_process": {
      "type": "object",
      "properties": {
        "entity_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^proc_[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "pid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "executable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "command_line": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent": {
          "$ref": "#/$defs/legacy_parent"
        },
        "hash": {
          "type": "object",
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256_or_null"
            }
          },
          "required": [
            "sha256"
          ],
          "additionalProperties": false
        },
        "start_time_ticks": {
          "$ref": "#/$defs/nullable_u64"
        }
      },
      "required": [
        "entity_id",
        "pid",
        "name",
        "executable",
        "command_line",
        "parent",
        "hash",
        "start_time_ticks"
      ],
      "additionalProperties": false,
      "description": "entity_id equals subject.entity_id (null unless native_exact or source_scoped)."
    },
    "bounded_text": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "$ref": "#/$defs/text"
            },
            "original_bytes": {
              "$ref": "#/$defs/decimal_u64"
            },
            "truncated": {
              "type": "boolean"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "text",
            "original_bytes",
            "truncated",
            "sha256"
          ],
          "additionalProperties": false,
          "description": "At most 16384 UTF-8 bytes cut on a character boundary; sha256 and original_bytes describe the full source text."
        },
        {
          "type": "null"
        }
      ]
    },
    "ext_process": {
      "type": "object",
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "entity_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^proc_[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "identity": {
          "$ref": "#/$defs/process_reference"
        },
        "executable": {
          "$ref": "#/$defs/nullable_text"
        },
        "user": {
          "$ref": "#/$defs/nullable_text"
        },
        "start_time_ticks": {
          "$ref": "#/$defs/nullable_u64"
        },
        "parent": {
          "type": "object",
          "properties": {
            "entity_id": {
              "type": "null"
            }
          },
          "required": [
            "entity_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "pid",
        "entity_id",
        "identity",
        "executable",
        "user",
        "start_time_ticks",
        "parent"
      ],
      "additionalProperties": false
    },
    "unavailable": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "reason"
        ],
        "additionalProperties": false
      },
      "description": "Fields the source could not supply, with the reason."
    },
    "attribution": {
      "type": "object",
      "properties": {
        "confidence": {
          "const": "reported"
        },
        "native_instance_verified": {
          "const": false
        }
      },
      "required": [
        "confidence",
        "native_instance_verified"
      ],
      "additionalProperties": false
    }
  }
}
