{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panopticon.example/schema/response-artifact-v1.schema.json",
  "title": "Command-bound structured investigation artifact",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^art_[0-9a-f]{64}$"
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "host_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "enum": [
        "process_snapshot",
        "network_snapshot",
        "file_metadata",
        "execution_report"
      ]
    },
    "media_type": {
      "const": "application/json"
    },
    "content_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1398104,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "command_id",
    "correlation_id",
    "host_id",
    "kind",
    "media_type",
    "content_bytes",
    "sha256",
    "content_base64"
  ]
}
