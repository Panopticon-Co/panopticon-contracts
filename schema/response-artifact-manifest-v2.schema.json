{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panopticon.example/schema/response-artifact-manifest-v2.schema.json",
  "title": "Endpoint-signed command-bound JSON investigation artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2"},
    "artifact_id": {"type": "string", "pattern": "^art_[0-9a-f]{64}$"},
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "host_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "command_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "kind": {"enum": ["process_snapshot", "network_snapshot", "file_metadata", "execution_report"]},
    "media_type": {"const": "application/json"},
    "content_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "produced_at_unix": {"type": "integer", "minimum": 0, "maximum": 253402300799},
    "authorization": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "ES256"},
        "key_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      },
      "required": ["algorithm", "key_id", "signature"]
    }
  },
  "required": ["schema_version", "artifact_id", "agent_id", "host_id", "command_id",
    "correlation_id", "kind", "media_type", "content_bytes", "sha256", "produced_at_unix",
    "authorization"]
}
